# All nitrogen atoms except the tagged N2.
other_n: GROUP ATOMS=1-122,125-240

# Translation-invariant hydration coordinate.
water_cn: COORDINATION ...
  GROUPA=probe
  GROUPB=water_o
  SWITCH={RATIONAL R_0=4.0 NN=6 MM=12}
... water_cn:

# Translation-invariant gas aggregation coordinate. Nitrogen atoms are used
# for PLUMED 2.8 compatibility; the factor 0.5 gives an N2-COM-like scale.
gas_cn_atoms: COORDINATION ...
  GROUPA=probe
  GROUPB=other_n
  SWITCH={RATIONAL R_0=5.5 NN=6 MM=12}
... gas_cn_atoms:
gas_cn: CUSTOM ARG=gas_cn_atoms FUNC=0.5*x PERIODIC=NO

# Diagnostic state coordinate; it is printed but not directly biased.
state: CUSTOM ARG=water_cn,gas_cn FUNC=x-y PERIODIC=NO

# Low-bias two-dimensional well-tempered metadynamics.
metad: METAD ...
  ARG=water_cn,gas_cn
  SIGMA=0.6,0.6
  HEIGHT=0.002
  PACE=500
  BIASFACTOR=10.0
  TEMP=330.0
  GRID_MIN=-1.0,-1.0
  GRID_MAX=18.0,14.0
  GRID_SPACING=0.1,0.1
  FILE=HILLS
... metad:

PRINT ARG=water_cn,gas_cn_atoms,gas_cn,state,metad.bias FILE=COLVAR STRIDE=100
FLUSH STRIDE=100
